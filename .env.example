BOT_TOKEN=
STORE_NAME=
# Telegram admin ID
ADMIN_TELEGRAM_ID=

# 3x-ui panel
XUI_BASE_URL=
XUI_API_TOKEN=

# Inbound IDs from 3x-ui
XUI_NL_INBOUND_ID=2
XUI_DE_INBOUND_ID=4

# Public subscription base URL
XUI_SUBSCRIPTION_BASE_URL=
PAYMENT_CARD_NUMBER=6037XXXXXXXXXXXX
PAYMENT_CARD_OWNER=
# Optional: public Telegram channel/post containing payment-card details.
# When set, the bot shows a button instead of the card number above.
PAYMENT_CARD_CHANNEL_URL=

# Optional: required channel membership. Use @username for a public channel,
# or its -100... ID for a private channel. Leave empty to disable this check.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=

# Optional: destination group/channel for messages sent through bot support.
# Leave empty to keep only the direct-support button.
SUPPORT_CHAT_ID=
